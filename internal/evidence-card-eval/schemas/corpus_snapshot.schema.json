{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litradar.local/schemas/corpus_snapshot.v1.json",
  "title": "LitRadar Staging Corpus Snapshot (read-only export)",
  "description": "Immutable, read-only export of the staging paper metadata + abstracts that the offline evaluator samples from. Produced by src/export_staging_readonly.py via authenticated GETs only. Never written back to staging. The sha256 of this file (canonical JSON) is recorded in the sample manifest for provenance.",
  "type": "object",
  "required": ["snapshot_version", "source", "staging_commit", "exported_at", "ready_sources", "papers"],
  "additionalProperties": false,
  "properties": {
    "snapshot_version": { "type": "string", "const": "1.0.0" },
    "source": {
      "type": "object",
      "description": "Provenance of the export.",
      "required": ["base_url", "method"],
      "properties": {
        "base_url": { "type": "string", "description": "e.g. https://eloquent-rebirth-staging.up.railway.app" },
        "method": { "type": "string", "enum": ["authenticated_read_only_get"], "description": "Only GET requests; no POST/PATCH/DELETE." },
        "exported_by": { "type": "string", "description": "Actor label; never a credential." }
      }
    },
    "staging_commit": { "type": "string", "description": "Commit reported by GET /api/version at export time." },
    "exported_at": { "type": "string", "description": "ISO-8601 UTC timestamp of export." },
    "ready_sources": {
      "type": "array",
      "description": "The 7 ready (connectorStatus=ready) Crossref sources that form the sampling frame.",
      "items": {
        "type": "object",
        "required": ["source_id", "name", "issn", "paper_count"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string" },
          "name": { "type": "string" },
          "issn": { "type": ["string", "null"] },
          "paper_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paper_id", "doi", "source_id", "title", "abstract_text", "published_date"],
        "additionalProperties": false,
        "properties": {
          "paper_id": { "type": "string", "description": "staging papers.id (UUID)." },
          "doi": { "type": ["string", "null"] },
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "abstract_text": { "type": ["string", "null"] },
          "published_date": { "type": ["string", "null"] },
          "authors": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] }
        }
      }
    }
  }
}
